# Copy this file to .env and adjust as needed.
# All settings have sane defaults if .env is missing.

# Port the app is served on (inside the container, when run via Docker --
# see APP_HOST_PORT below for the host-side port on a Docker/VPS deployment)
PORT=8000

# Docker/docker-compose only: which port on the HOST this is reachable at
# (127.0.0.1:<this> -- never exposed beyond localhost, nginx/Caddy fronts
# it). Change this if 8000 is already taken by something else on the box;
# the container's internal PORT above is unaffected either way.
APP_HOST_PORT=8000

# Secret used to sign session cookies. CHANGE THIS for any real deployment.
SESSION_SECRET=change-this-to-a-long-random-string

# Session cookie lifetime, in hours
SESSION_MAX_AGE_HOURS=12

# Set to "true" once the app is served over HTTPS (e.g. on Railway, or behind
# your own reverse proxy with a TLS certificate). Keep "false" for local
# http://localhost development -- a "true" value here over plain HTTP will
# silently break login, since browsers won't send a Secure cookie back over http.
SESSION_SECURE_COOKIES=false

# Path to the SQLite database file and uploads folder (relative to repo root)
DATA_DIR=./data

# SLA target resolution time, in hours, per priority
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=120

# Max upload size for a single attachment, in MB
MAX_UPLOAD_MB=15

# First-run admin/agent account (only used the very first time the DB is created)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FULLNAME=IT Administrator

# Optional: Microsoft 365 / Entra ID single sign-on. Leave all four blank to
# keep local username/password as the only login method (the default). Set
# all four to show a "Sign in with Microsoft" button alongside it. See
# README.md for the Azure App Registration steps to get these values.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=

# Optional: outbound email (SMTP). Leave SMTP_HOST blank to keep in-app
# notifications only (the default) -- nothing is sent, nothing breaks.
# Set these to enable emails for ticket creation, status/progress changes,
# resolution, and new comments. See README for setup notes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=IT Support & Maintenance Tracker

# Public URL of your deployment, used to build ticket links inside emails.
# Change this once deployed -- the localhost default only makes sense locally.
APP_BASE_URL=http://localhost:8000

# Optional: reply-by-email (requires SMTP_HOST above to also be set). Replying
# to a ticket notification email adds the reply as a comment on that ticket.
# Needs SendGrid Inbound Parse configured on a subdomain you control -- see
# README for the full setup (MX record + webhook URL). Leave blank to skip.
INBOUND_EMAIL_DOMAIN=
INBOUND_WEBHOOK_TOKEN=
