# nginx reverse-proxy config for one domain, matching the same
# sites-available/sites-enabled convention already used on this box for its
# other sites. vps-setup.sh fills in YOUR_DOMAIN and installs this as
# /etc/nginx/sites-available/<domain>, symlinked into sites-enabled --
# it does not touch any other site's config.
#
# Starts HTTP-only on purpose: certbot's nginx plugin edits this file in
# place afterward to add the SSL server block + HTTP->HTTPS redirect, once
# DNS for the domain actually resolves to this server.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    # Uploaded attachments can be sizeable -- match the app's own default
    # (see MAX_UPLOAD_MB in .env.example); raise both together if you do.
    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }
}
