# Copy this file to .env and adjust as needed.
# All settings have sane defaults if .env is missing.

# Port the app is served on
PORT=8000

# Secret used to sign session cookies. CHANGE THIS for any real deployment.
SESSION_SECRET=change-this-to-a-long-random-string

# Session cookie lifetime, in hours
SESSION_MAX_AGE_HOURS=12

# Set to "true" once the app is served over HTTPS (e.g. on Railway, or behind
# your own reverse proxy with a TLS certificate). Keep "false" for local
# http://localhost development -- a "true" value here over plain HTTP will
# silently break login, since browsers won't send a Secure cookie back over http.
SESSION_SECURE_COOKIES=false

# Path to the SQLite database file and uploads folder (relative to repo root)
DATA_DIR=./data

# SLA target resolution time, in hours, per priority
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=24
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=120

# Max upload size for a single attachment, in MB
MAX_UPLOAD_MB=15

# First-run admin/agent account (only used the very first time the DB is created)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FULLNAME=IT Administrator
