# Caddy reverse-proxy config. Caddy gets you free, fully automatic HTTPS
# (issues + renews the Let's Encrypt certificate itself, no certbot/cron
# needed) with basically nothing to configure -- this is the entire file.
#
# vps-setup.sh copies this to /etc/caddy/Caddyfile with YOUR_DOMAIN replaced
# by the domain you gave it. To edit by hand instead: replace YOUR_DOMAIN
# below with your real domain/subdomain (e.g. support.yourdomain.com) and
# copy this to /etc/caddy/Caddyfile, then `systemctl reload caddy`.

YOUR_DOMAIN {
	reverse_proxy 127.0.0.1:8000

	# Uploaded attachments can be sizeable -- match the app's own default
	# (see MAX_UPLOAD_MB in .env.example); raise both together if you do.
	request_body {
		max_size 20MB
	}
}
